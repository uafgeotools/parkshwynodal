    RowBox[{
     RowBox[{"LineLegend", "[", 
      RowBox[{"styles", ",", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
        "\"\<tp(t)\>\"", ",", "\[IndentingNewLine]", 
         "\"\<t0 + (1 + v/c) t\>\"", ",", "\[IndentingNewLine]", 
         "\"\<t0 + (1 \[Minus] v/c) t\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.25", ",", "0.85"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968231327376581*^9, 3.968231327379677*^9}, {
