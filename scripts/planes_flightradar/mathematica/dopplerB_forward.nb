   3.969062480758819*^9, 3.9690629756922493`*^9, {3.96909339588896*^9, 
   3.969093396087884*^9}},ExpressionUUID->"2eed75c1-2331-473d-9ff5-\
c713c5a65094"],

Cell[CellGroupData[{

Cell[BoxData[{"t0", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tprootstart", "=", "t0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"troot", "=", 
  RowBox[{"tp", "/.", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", 
       RowBox[{"v", ",", "t0", ",", "d0", ",", "c", ",", "tp"}], "]"}], "==", 
      "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"tp", ",", "tprootstart"}], "}"}]}], 
