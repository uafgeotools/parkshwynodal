Cell[CellGroupData[{

Cell["\<\
ASIDE: The curves can be centered on the arrival time of closest approach.
This is achieved by shifting the time coordinate by tp0 = t0 + d0/c.
Then we see the expected flattening toward F = fs.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
   3.9600557556439857`*^9, 3.960055766072599*^9}, {3.9600561161290617`*^9, 
   3.96005612048778*^9}, {3.9607529816075277`*^9, 3.960752988092719*^9}, 
   3.960754521522429*^9, 3.960817061641066*^9, {3.9608175224708652`*^9, 
   3.960817544426053*^9}, {3.9609993056756277`*^9, 3.960999312082012*^9}, 
   3.968867842479327*^9, {3.9692680935009947`*^9, 3.9692680994981537`*^9}, {
   3.987176822420491*^9, 3.987176841938176*^9}, {3.9871784099056377`*^9, 
   3.987178472518881*^9}, {3.987178548250551*^9, 3.987178554058626*^9}, {
   3.987180033406231*^9, 3.987180033851109*^9}, {3.9871812132101088`*^9, 
   3.9871812144217873`*^9}, {3.987181370113736*^9, 3.987181379532859*^9}, {
   3.9871815779407997`*^9, 3.987181592887864*^9}, {3.987181829525803*^9, 
   3.987181836051731*^9}, {3.987182021616226*^9, 
   3.987182048706643*^9}},ExpressionUUID->"2a2012b2-e5bf-4832-87a4-\
1e5ac43ee391"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Fcentered", "[", 
   RowBox[{"d0_", ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"Ft", "[", 
   RowBox[{"v", ",", "t0", ",", "d0", ",", "fs", ",", "c", ",", 
    RowBox[{"\[Tau]", "+", "t0", "+", 
     RowBox[{"d0", "/", "c"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Fcentered", "[", 
       RowBox[{"d0", ",", "tp"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d0", ",", "d0Vals"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", ",", 
     RowBox[{"-", "thwid"}], ",", "thwid"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<tp\>\"", ",", "\"\<Ft\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Ft vs tp for varying d0\>\""}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", 
      RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
      RowBox[{"Point", "[", "Pcen", "]"}], ",", "Black", ",", 
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "fs"}], "}"}], "]"}], ",", "Gray", ",", "Dashed", 
      ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "thwid"}], ",", "fs"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"thwid", ",", "fs"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.987181451864882*^9, 3.9871814530755167`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"c92c0d1f-5b21-465a-8a71-cbdfa805ef04"],

