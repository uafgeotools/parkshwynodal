Cell[CellGroupData[{

Cell["\<\
Let\[CloseCurlyQuote]s start by finding the root of t[ t\[CloseCurlyQuote] ], \
numerically and analytically.
It differs from t0 by d0/c.\
\>", "Subsubsection",
 CellChangeTimes->{{3.968230215985426*^9, 3.9682302328161697`*^9}, 
   3.9682303080804453`*^9, {3.968230662276119*^9, 3.968230666423564*^9}, {
