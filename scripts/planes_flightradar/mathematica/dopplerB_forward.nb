Cell[CellGroupData[{

Cell["\<\
This is the value in the final column.
Since Fratio is < 1, D1Fratio < Fratio, meaning that the relative shift in \
the slopes is larger than the relative shift in the function evaluations.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
