Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"v_", ",", "t0_", ",", "d0_", ",", "c_", ",", "tp_"}], "]"}], ":=", 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["d0", "2"]}], " ", 
       SuperscriptBox["v", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["c", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["d0", "2"], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"tp", "-", "t0"}], ")"}], "2"], " ", 
          SuperscriptBox["v", "2"]}]}], ")"}]}]}], 
     SuperscriptBox["c", "4"]]]}], "*)"}]], "Input",
