Cell[CellGroupData[{

Cell["\<\
ASIDE: And if the paths are all far from the sensor (d0 --> infty), then F \
--> fsshift.
These are still Doppler curves, but essentially zoomed in.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
   3.9600557556439857`*^9, 3.960055766072599*^9}, {3.9600561161290617`*^9, 
