Cell["\<\
What about the inverse of this plot?
This is the function tp[ t ], which is sensor time.\
\>", "Subsubsection",
 CellChangeTimes->{{3.968230215985426*^9, 3.9682302328161697`*^9}, 
   3.9682303080804453`*^9, {3.968230662276119*^9, 3.968230666423564*^9}, {
   3.9682309662055397`*^9, 3.968230970630978*^9}, {3.968246679755121*^9, 
   3.968246708747925*^9}, 3.968250118101009*^9, 
   3.969063450842968*^9},ExpressionUUID->"5a697724-cae1-40e6-8d52-\
18b62e876bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tpfun", "[", "t_", "]"}], ":=", 
   RowBox[{"t", "+", "t0", "+", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["d0", "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"v", " ", "t"}], ")"}], "2"]}]], "/", "c"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.969063052709877*^9, 3.969063057717142*^9}, {
  3.96918490905595*^9, 3.969184929625383*^9}},
 CellLabel->
  "In[194]:=",ExpressionUUID->"ce1c093c-917a-450a-8d29-79195c583d53"],

