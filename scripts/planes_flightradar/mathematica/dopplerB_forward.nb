Cell[BoxData[{"t0", "\[IndentingNewLine]", 
 RowBox[{"v", "/", "c"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tr", "[", "tp_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"tp", "-", "t0"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"v", "/", "c"}]}], ")"}]}]}], ";"}], " "}], "\n", 
