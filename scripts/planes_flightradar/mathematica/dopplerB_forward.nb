Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tpAt", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t0", "+", 
      RowBox[{
       RowBox[{"d0Vals", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "/", "c"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pts", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tpAt", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{
       StyleBox["Fvaryd0",
        FontColor->RGBColor[1, 0, 0]], "[", 
       RowBox[{
        RowBox[{"d0Vals", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"tpAt", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"dots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"colors", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
       RowBox[{"Point", "[", 
        RowBox[{"pts", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Fvaryd0", "[", 
       RowBox[{"d0", ",", "tp"}], "]"}], ",", 
