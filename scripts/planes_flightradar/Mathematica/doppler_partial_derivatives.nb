89b5982a8e1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Ft", "[", 
         RowBox[{"v0", ",", "tp0", ",", "l", ",", "f0", ",", "c", ",", "tp"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"tp", ",", "2"}], "}"}]}], "]"}], "==", "0"}], ",", "tp"}], 
    "]"}], " ", "*)"}], "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
    "not", " ", "sure", " ", "if", " ", "this", " ", "will", " ", "run"}],
