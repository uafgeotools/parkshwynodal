 CellLabel->
  "In[1676]:=",ExpressionUUID->"968dc489-d4fe-4ee0-83cd-507a3add3033"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Lfactor", "[", 
   RowBox[{"v0_", ",", "f0_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "f0"}], " ", 
   RowBox[{"vfactor", "[", 
