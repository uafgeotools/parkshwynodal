Cell[CellGroupData[{

Cell["\<\
Main equations for the Doppler frequency (Meng and Ben-Zion, 2018, Eq. 3b).
Note that tp is the dependent variable and should be thought of a time in the \
spectrogram.
Note that FfactorA < 0, Ffactor < 1, and Ft > f0.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
  3.9600557556439857`*^9, 3.960055766072599*^9}, {3.960831219637995*^9, 
  3.9608312364610653`*^9}, {3.960992110718937*^9, 3.9609921148898697`*^9}, {
  3.960992161024211*^9, 3.9609921688742*^9}, {3.962214203686187*^9, 
  3.9622142325194883`*^9}, {3.96221453962457*^9, 3.962214590142404*^9}, {
  3.9654784822599087`*^9, 
  3.965478485906588*^9}},ExpressionUUID->"999a9518-1339-448f-b81a-\
97e8f0f9fefb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"t", "[", 
    RowBox[{"v0_", ",", "tp0_", ",", "l_", ",", "c_", ",", "tp_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"tp", "-", "tp0"}], ")"}], "-", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"tp", "-", "tp0"}], ")"}], "2"], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["v0", "2"], 
           SuperscriptBox["c", "2"]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"tp", "-", "tp0"}], ")"}], "2"], "-", 
          FractionBox[
           SuperscriptBox["l", "2"], 
           SuperscriptBox["c", "2"]]}], ")"}]}]}], "]"}]}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       SuperscriptBox["v0", "2"], 
       SuperscriptBox["c", "2"]]}], ")"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FfactorA", "[", 
   RowBox[{"v0_", ",", "tp0_", ",", "l_", ",", "c_", ",", "tp_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["v0", "c"], 
   FractionBox[
    RowBox[{"v0", " ", 
     RowBox[{"t", "[", 
      RowBox[{"v0", ",", "tp0", ",", "l", ",", "c", ",", "tp"}], "]"}]}], 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["l", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"v0", " ", 
         RowBox[{"t", "[", 
          RowBox[{"v0", ",", "tp0", ",", "l", ",", "c", ",", "tp"}], "]"}]}], 
        ")"}], "2"]}], "]"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ffactor", "[", 
    RowBox[{"v0_", ",", "tp0_", ",", "l_", ",", "c_", ",", "tp_"}], "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"FfactorA", "[", 
     RowBox[{"v0", ",", "tp0", ",", "l", ",", "c", ",", "tp"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ft", "[", 
    RowBox[{
    "v0_", ",", "tp0_", ",", "l_", ",", "f0_", ",", "c_", ",", "tp_"}], "]"}],
    ":=", 
   FractionBox["f0", 
    RowBox[{"Ffactor", "[", 
     RowBox[{"v0", ",", "tp0", ",", "l", ",", "c", ",", "tp"}], "]"}]]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.921256639538512*^9, 3.921256711958551*^9}, {
   3.9212567713141108`*^9, 3.921256803969215*^9}, {3.921257671113023*^9, 
