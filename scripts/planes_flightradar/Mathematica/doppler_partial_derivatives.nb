Cell[CellGroupData[{

Cell["\<\
Measure the slope by choosing two points on the linear section, then solve \
for L.
KEY POINT: tp is set equal to tp0, so we are looking at the peak slope at the \
center of the Doppler curve.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
   3.9600557556439857`*^9, 3.960055766072599*^9}, {3.9600561161290617`*^9, 
   3.96005612048778*^9}, {3.9607529816075277`*^9, 3.960752988092719*^9}, 
   3.960754521522429*^9, 3.960817061641066*^9, {3.9608175224708652`*^9, 
   3.960817544426053*^9}, {3.960994848124835*^9, 3.9609948633003893`*^9}, {
   3.960999515927622*^9, 3.960999517531651*^9}, {3.961000082892755*^9, 
   3.9610000890638847`*^9}, {3.961075275560417*^9, 3.961075285889018*^9}, {
   3.9634243780118103`*^9, 3.963424382204685*^9}, {3.9634244362729607`*^9, 
   3.963424509292951*^9}},ExpressionUUID->"5df42653-35a1-4b3b-8940-\
d6cb04340f7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D1F", "[", 
   RowBox[{"v0z", ",", "tp0z", ",", "lz", ",", "f0z", ",", "cz", ",", 
    StyleBox["tp0z",
     FontColor->RGBColor[1, 0, 0]]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.961075369825121*^9, 3.961075403651963*^9}, 
   3.961075449567575*^9, {3.9610754846653357`*^9, 3.9610754888650312`*^9}, {
   3.961075651506688*^9, 3.9610756531524887`*^9}, {3.961075747868183*^9, 
   3.9610757486657677`*^9}, 3.961075802491355*^9, 3.965416611650529*^9},
 CellLabel->
  "In[1675]:=",ExpressionUUID->"2904d293-1752-47ab-bf81-04f09ac94b3c"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["cz", "3"], " ", "f0z", " ", 
   SuperscriptBox["v0z", "2"]}], 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", "cz", " ", 
     SuperscriptBox["lz", "2"], " ", 
     SuperscriptBox["v0z", "2"]}], 
    SqrtBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["lz", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"cz", "-", "v0z"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"cz", "+", "v0z"}], ")"}]}], 
      SuperscriptBox["cz", "4"]]]], "-", 
   RowBox[{
    SuperscriptBox["cz", "4"], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["cz", "2"], " ", 
       SuperscriptBox["lz", "2"]}], 
      RowBox[{
       SuperscriptBox["cz", "2"], "-", 
       SuperscriptBox["v0z", "2"]}]]]}], "-", 
   RowBox[{
    SuperscriptBox["v0z", "4"], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["cz", "2"], " ", 
       SuperscriptBox["lz", "2"]}], 
      RowBox[{
       SuperscriptBox["cz", "2"], "-", 
       SuperscriptBox["v0z", "2"]}]]]}]}]]], "Output",
 CellChangeTimes->{
  3.961075353117262*^9, {3.961075383188993*^9, 3.96107541018934*^9}, 
   3.9610754501545887`*^9, 3.961075489117465*^9, 3.961075653706553*^9, 
   3.961075763706458*^9, 3.961075803907852*^9, 3.963568099406198*^9, 
   3.965416700038926*^9, 3.965416780617774*^9, 3.9654169774581623`*^9, 
   3.965479197496243*^9},
 CellLabel->
  "Out[1675]=",ExpressionUUID->"2b63fef0-eced-495e-8fb3-5e831731465d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cleaner expression, which factors out 1/L", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
   3.9600557556439857`*^9, 3.960055766072599*^9}, {3.9600561161290617`*^9, 
