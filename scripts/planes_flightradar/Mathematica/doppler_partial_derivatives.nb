          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"tp", ",", "3"}], "}"}]}], "]"}], "==", "0"}], ",", "tp"}], 
    "]"}], " ", "*)"}], "  ", 
  RowBox[{"(*", " ", 
