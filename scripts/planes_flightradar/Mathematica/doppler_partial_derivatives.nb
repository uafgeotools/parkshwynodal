   3.9610762233512897`*^9}},ExpressionUUID->"9b1e9387-e601-44b1-a1d6-\
1969a7d375d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vfactor", "[", 
   RowBox[{"v0_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["v0", "2"], " "}], "c"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["v0", "c"], ")"}], "2"]}], ")"}], 
    RowBox[{
     RowBox[{"-", "3"}], "/", "2"}]]}]}]], "Input",
 CellChangeTimes->{{3.9610760472532883`*^9, 3.961076178625723*^9}, {
  3.961076271166741*^9, 3.961076284228573*^9}, {3.961076514502411*^9, 
