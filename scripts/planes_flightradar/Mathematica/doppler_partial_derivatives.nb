Cell[CellGroupData[{

Cell["\<\
Let \[CurlyEpsilon] = v0/c. Re-write as a series in \[CurlyEpsilon], then \
consider approximations.\
\>", "Subsection",
 CellChangeTimes->{{3.960055700726102*^9, 3.96005570986094*^9}, {
  3.960056346726346*^9, 3.960056358587674*^9}, {3.960831014520344*^9, 
