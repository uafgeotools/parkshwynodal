Cell[BoxData[
 RowBox[{
  RowBox[{"partialv", "[", 
   RowBox[{"v0_", ",", "tp0_", ",", "l_", ",", "f0_", ",", "c_", ",", "tp_"}],
    "]"}], ":=", 
  RowBox[{"-", 
