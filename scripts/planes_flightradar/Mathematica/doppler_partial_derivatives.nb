                   RowBox[{"tp", "-", "tp0"}], ")"}], "2"]}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 FractionBox[
                  SuperscriptBox["v0", "2"], 
                  SuperscriptBox["c", "2"]]}], ")"}]}]}]]}], ")"}], "2"]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            SuperscriptBox["v0", "2"], 
            SuperscriptBox["c", "2"]]}], ")"}], "2"]]}]]}]]}]]], "Output",
