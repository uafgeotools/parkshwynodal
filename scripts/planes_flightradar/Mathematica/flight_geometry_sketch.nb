              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"\[Theta]", "/", "2"}], "]"}], " ", "b"}]}]}], ";", 
            RowBox[{"(*", 
             RowBox[{"angle", " ", "bisector"}], "*)"}], 
            RowBox[{"rGamma", "=", 
             RowBox[{"0.8", " ", "rArc"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
             "label", " ", "a", " ", "bit", " ", "closer", " ", "to", " ", 
              "O"}], "*)"}], 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Thickness", "[", "tkns", "]"}], ",", 
              RowBox[{"Line", "[", "arcpts", "]"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{"ShowText", ",", 
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<\[Gamma]\>\"", ",", "fsize", ",", "Bold", ",", 
                    "Black"}], "]"}], ",", 
                  RowBox[{"oPt", "+", 
                   RowBox[{"rGamma", " ", "bis"}], "+", 
                   RowBox[{"{", 
                    RowBox[{"0.012", ",", "0.012", ",", "0.012"}], "}"}]}]}], 
                 "]"}], ",", "Nothing"}], "]"}]}], "}"}]}]}], "]"}]}], "]"}], 
       ",", 
       RowBox[{"planeGlyph3D", "[", 
        RowBox[{
         RowBox[{"QofT", "[", 
          RowBox[{"-", "1.45"}], "]"}], ",", "v", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", ".4", ",", 
         RowBox[{"GrayLevel", "[", ".5", "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"Boxed", "->", "False"}], ",", 
     RowBox[{"ImageSize", "->", "isize"}], ",", 
